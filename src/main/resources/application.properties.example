spring.application.name=demo
spring.datasource.url=jdbc:postgresql://localhost:YOUR_PORT/usp_health_center
spring.datasource.password=YOUR_PASSWORD
spring.datasource.username=postgres
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
server.tomcat.basedir=./tomcat-temp
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# Auto-create open slots for the demo doctors (dr.patel, dr.lee, dr.sharma) for the
# next 7 days on every startup. Testing only - leave off so doctors create their own slots.
app.demo-slots=false
